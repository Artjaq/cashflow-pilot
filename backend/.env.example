# Config pour lancer le backend en local (hors Docker Compose).
# En Docker Compose, ces valeurs sont fournies par le .env à la racine du repo.

DATABASE_URL=postgresql+asyncpg://cashflow:change-me@localhost:5432/cashflow_pilot

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DEFAULT_CURRENCY=CHF

AI_PROVIDER=claude
ANTHROPIC_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
