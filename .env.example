# --- PostgreSQL ---
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cashflow_pilot

# --- Backend ---
# Utilisé directement par le backend hors docker-compose (dev local).
# En Docker Compose, DATABASE_URL est recalculée à partir des variables POSTGRES_* ci-dessus.
DATABASE_URL=postgresql+asyncpg://cashflow:change-me@localhost:5432/cashflow_pilot

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Devise d'affichage par défaut (Phase 4 pour le multi-devises)
DEFAULT_CURRENCY=CHF

# --- IA (Phase 3, posé dès maintenant pour ne pas casser la config plus tard) ---
AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- Gmail (Phase 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
